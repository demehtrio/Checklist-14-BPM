{
  "entities": {
    "Checklist": {
      "title": "Checklist",
      "description": "Registro de checklist de viatura",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "servico": { "type": "string" },
        "dataArmou": { "type": "string" },
        "horaArmou": { "type": "string" },
        "condutorSai": { "type": "string" },
        "telCondutorSai": { "type": "string" },
        "condutorEntra": { "type": "string" },
        "telCondutorEntra": { "type": "string" },
        "viatura": { "type": "string" },
        "placa": { "type": "string" },
        "prefixo": { "type": "string" },
        "kmInicial": { "type": "string" },
        "saldoCombustivel": { "type": "string" },
        "mapaDiario": { "type": "string" },
        "equipamentos": { "type": "array", "items": { "type": "string" } },
        "luzFarolAlto": { "type": "string" },
        "luzFarolBaixo": { "type": "string" },
        "luzLanterna": { "type": "string" },
        "luzFreioLanternaTraseira": { "type": "array", "items": { "type": "string" } },
        "luzPlaca": { "type": "string" },
        "pneus": { "type": "string" },
        "sistemaFreio": { "type": "string" },
        "oleoMotor": { "type": "string" },
        "proxTrocaOleoKm": { "type": "string" },
        "partesInternas": { "type": "array", "items": { "type": "string" } },
        "sistemaTracao": { "type": "string" },
        "partesExternas": { "type": "array", "items": { "type": "string" } },
        "limpeza": { "type": "string" },
        "descricaoAlteracoes": { "type": "string" },
        "kmFinal": { "type": "string" },
        "horaDesarmou": { "type": "string" },
        "fotos": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "User": {
      "title": "User",
      "description": "Perfil de usuário e permissões",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/checklists/{checklistId}": {
      "schema": "Checklist",
      "description": "Coleção global de checklists"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfis de usuários e permissões"
    }
  }
}
